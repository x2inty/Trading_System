MAIN FORMULA – T Floor Price

def calculate_T_floor_price(market_cap, circulating_supply):
    """Main formula for T floor price"""

    # 1 Stress Factor T (liquid tokens)
    stress_factor = 0.99  # 99% sellable under extreme stress

    # 2. Effective sellable supply
    sellable_supply = circulating_supply * stress_factor

    # 3. Final floor price
    floor_price = market_cap / sellable_supply

    return floor_price

Mathematical Formula:
T_Floor_Price = Market_Cap ÷ (Circulating_Supply × 0.99)
Where:

Market_Cap_API = Real-time data from CoinRanking

Circulating_Supply_API = Real-time data from CoinRanking

0.99 = Stress Factor T (99% sellable supply)

BEAR SCENARIO FORMULAS
def calculate_bear_scenarios(market_cap, supply):
    """Bear scenarios from -10% to -40%"""

    bear_scenarios = {}

    for pct in [10, 20, 30, 40]:
        # Stressed Market Cap
        stressed_mc = market_cap * (1 - pct/100)

        # Resulting floor price
        bear_floor = stressed_mc / (supply * 0.99)

        bear_scenarios[f'-{pct}%'] = bear_floor

    return bear_scenarios

Mathematical Formulas:

Bear_-10% = (MC × 0.90) ÷ (Supply × 0.99)
Bear_-20% = (MC × 0.80) ÷ (Supply × 0.99)
Bear_-30% = (MC × 0.70) ÷ (Supply × 0.99)
Bear_-40% = (MC × 0.60) ÷ (Supply × 0.99)

BULL SCENARIO FORMULAS
def calculate_bull_scenarios(market_cap, supply):
    """Bull Scenarios +10% to +40%"""
    
    bull_scenarios = {}
    
    for pct in [10, 20, 30, 40]:
        # Bullish Market Cap
        bull_mc = market_cap * (1 + pct / 100)
        
        # Resulting target price
        bull_target = bull_mc / (supply * 0.99)
        
        bull_scenarios[f'+{pct}%'] = bull_target
    
    return bull_scenarios

Mathematical Formulas:

Bull_+10% = (MC × 1.10) ÷ (Supply × 0.99)
Bull_+20% = (MC × 1.20) ÷ (Supply × 0.99)
Bull_+30% = (MC × 1.30) ÷ (Supply × 0.99)
Bull_+40% = (MC × 1.40) ÷ (Supply × 0.99)

